# ── Secrets & private config (never commit) ──────────────────────
# Local Worker secrets (Google OAuth, TOKEN_ENC_KEY, Resend key)
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Wrangler config holds the D1 database id, domain and owner email.
# Copy wrangler.example.jsonc → wrangler.jsonc and fill it in.
wrangler.json
wrangler.jsonc
wrangler.toml
!wrangler.example.jsonc

# Generated from wrangler.jsonc by `npm run cf-typegen` (contains its vars)
worker-configuration.d.ts

# Google OAuth client downloads and other credentials/keys
client_secret*.json
*credentials*.json
service-account*.json
*.pem
*.key
*.p12
*.p8
*.pfx
*.cer
*.crt
*.mobileprovision

# Mobile app signing & Firebase configs (Expo / React Native)
*.jks 
*.keystore
!debug.keystore
google-services.json
GoogleService-Info.plist
credentials.json
.expo/
.expo-shared/

# ── Local state & build output ───────────────────────────────────
# Wrangler/Miniflare local D1, R2, KV state (contains test data)
.wrangler/
.dev/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Build output (dist also gets a copy of .dev.vars and wrangler.json)
dist/
build/
*.tsbuildinfo

# Dependencies
node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor / OS ──────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/
.DS_Store
Thumbs.db
*.swp

# Claude Code local settings
.claude/settings.local.json
